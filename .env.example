# CinemaLit Studio Environment Configuration

# ==========================================
# Google AI (Gemini) Configuration
# ==========================================
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_api_key_here

# Model to use for crew reasoning & MCP tools (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# Studio Memory & ClickHouse Configuration
# ==========================================
# Local Docker Compose (docker-compose.yml):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=cinemalit
CLICKHOUSE_PASSWORD=cinemagic2026
CLICKHOUSE_DATABASE=cinemalit
# CLICKHOUSE_SECURE=false  (default — plain HTTP, correct for local Docker)

# ClickHouse Cloud instead (set CLICKHOUSE_SECURE=true, HTTPS-only, port
# defaults to 8443 automatically when secure):
# CLICKHOUSE_HOST=your-instance.aws.clickhouse.cloud
# CLICKHOUSE_SECURE=true
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-password
# CLICKHOUSE_DATABASE=cinemalit

# ==========================================
# Web Auth (JWT)
# ==========================================
# Set a long random string in production — if left blank, a random secret is
# generated at server startup, invalidating all sessions on every restart.
JWT_SECRET=

# ==========================================
# ADK Director Agent
# ==========================================
# When true, ALL 6 of web/server.py's AI handlers (chat, analyze-script,
# ask-data, sync-script-to-db, dga-check, generate-storyboard) route through
# cinemalit_agent instead of calling Gemini directly. Needs a working
# cinemalit_agent/.env (see cinemalit_agent/README.md). Default false =
# original direct-Gemini behavior, completely unchanged.
USE_ADK_AGENT=false
