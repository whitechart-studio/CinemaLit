# Google AI API key
GOOGLE_API_KEY=your_google_ai_api_key_here
# Gemini model
GEMINI_MODEL=gemini-1.5-flash
# ClickHouse host
CLICKHOUSE_HOST=localhost
# ClickHouse port
CLICKHOUSE_PORT=8123
# ClickHouse user
CLICKHOUSE_USER=cinemalit
# ClickHouse password
CLICKHOUSE_PASSWORD=cinemagic2026
# ClickHouse database
CLICKHOUSE_DATABASE=cinemalit
# ClickHouse TLS
CLICKHOUSE_SECURE=false
# JWT signing secret
JWT_SECRET=
# Google OAuth client ID
GOOGLE_CLIENT_ID=
# Dev bypass for Google auth (no real token needed)
ALLOW_DEV_GOOGLE_AUTH=false
# Route AI handlers through cinemalit_agent
USE_ADK_AGENT=false
