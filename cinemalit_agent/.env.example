# Copy this file to agent/.env and fill in real values.
#
# NOTE on where env vars come from (three sources, keep them consistent):
#  1. tools.py imports web/server.py, which loads the PROJECT ROOT ".env" itself
#     (that's where CLICKHOUSE_* already lives for the rest of the app).
#  2. mcp_tools.py reads CLICKHOUSE_* from this process's own environment to pass
#     to the uvx-spawned mcp-clickhouse subprocess.
#  3. ADK itself loads GOOGLE_* vars from this file (or the shell environment)
#     to authenticate Gemini calls.
# Simplest: keep the CLICKHOUSE_* values below IDENTICAL to the root .env's.

# ==========================================
# Gemini auth — PENDING, fill in when ready
# ==========================================
# Option A (simplest for local `adk web`/`adk run` testing — no GCP project needed):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_ai_api_key_here

# Option B (only needed later, for deploying to Agent Engine):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# ClickHouse — must match the root .env / docker-compose.yml
# ==========================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=cinemalit
CLICKHOUSE_PASSWORD=cinemagic2026
CLICKHOUSE_DATABASE=cinemalit
