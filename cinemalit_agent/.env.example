# Copy this file to agent/.env and fill in real values.
#
# NOTE on where env vars come from (two sources, keep them consistent):
#  1. tools.py/crew_tools.py import web/server.py and web/db.py, which read
#     CLICKHOUSE_* from the process environment (loaded from the PROJECT
#     ROOT ".env" when web/server.py is imported first, e.g. via the web app).
#  2. cinemalit_agent/__init__.py loads THIS file (.env, next to it) with
#     override=True before importing anything else in the package — this is
#     what GOOGLE_*/GEMINI_MODEL/CLICKHOUSE_* below actually feed, regardless
#     of which submodule gets imported first.
# Simplest: keep the CLICKHOUSE_* values below IDENTICAL to the root .env's.

# ==========================================
# Gemini auth — PENDING, fill in when ready
# ==========================================
# Option A (simplest for local `adk web`/`adk run` testing — no GCP project needed):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_ai_api_key_here

# Option B (only needed later, for deploying to Agent Engine):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.0-flash

# Storyboard image generation (pipeline.py) uses pollinations.ai (free, no
# API key) — Gemini's own image models need a billing-enabled Google Cloud
# project even at low volume. Nothing to configure here.

# ==========================================
# ClickHouse — must match the root .env
# ==========================================
# ClickHouse Cloud example (see root .env.example for the local-Docker version):
CLICKHOUSE_HOST=your-instance.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=cinemalit
